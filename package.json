{
  "name": "@farts/release-namer",
  "version": "4.0.2",
  "description": "A tool for generating random release names",
  "author": "tadger",
  "repository": {
    "type": "git",
    "url": "https://github.com/tadger/release-namer"
  },
  "license": "MIT",
  "keywords": [],
  "type": "module",
  "scripts": {
    "build": "pkgroll",
    "ci:validate": "npm run type-check && biome ci --log-level=error --log-kind=pretty --diagnostic-level=error .",
    "cli": "tsx src/cli.ts",
    "cli:dist": "node ./dist/cli.mjs",
    "commit": "npx git-cz",
    "format": "biome check --log-level=error --log-kind=pretty --diagnostic-level=error --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "release-namer": "./dist/cli.mjs"
  },
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "haikunator": "^2.1.2",
    "meow": "^13.2.0",
    "namor": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.19.2",
    "cross-env": "^7.0.3",
    "pkgroll": "2.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "5.0.3"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ]
}
